# OceanBase connection
OB_HOST=127.0.0.1
OB_PORT=2881
OB_TENANT=your_tenant
OB_CLUSTER=
OB_USER=root
OB_PASSWORD='your_password'
OB_DATABASE=tpcc
OB_QUERY_TIMEOUT=300

# Schema build
WAREHOUSES=70
BUILD_VU=8

# Benchmark run
RUN_VU=8
RAMPUP_MINUTES=2
DURATION_MINUTES=5
ALL_WAREHOUSES=true
TIME_PROFILE=true
TOTAL_ITERATIONS=10000000

# Workload mode; use the same values for build and run
NO_STORED_PROCS=true
PREPARED_STATEMENTS=false

